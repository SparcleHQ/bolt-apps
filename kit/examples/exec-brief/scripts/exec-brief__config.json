{
  "app": {
    "id": "exec-brief",
    "chip": "exec-brief",
    "title": "Executive brief",
    "icon": "activity",
    "description": "Executive brief: four tiles then revenue, cash and customers charts, each titled with its takeaway. Needs Bolt 0.1.184 or newer. Sample data.",
    "service": "Executive brief"
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "SHOWCASE_API_KEY",
    "fixture_default": false,
    "on_missing_key": "sample",
    "fixture_file": "fixtures.json",
    "fixture_banner": false
  },
  "cache": {
    "ttl": 45,
    "stale_max": 86400
  },
  "endpoints": {
    "summary": {
      "path": "/v1/summary"
    }
  },
  "stats": {},
  "overview": {
    "widget": {
      "kind": "stack",
      "mode": "list_data",
      "bind": {
        "children": [
          {
            "kind": "cards",
            "bind": {
              "layout": "tiles",
              "visual_from": "kpi_visual",
              "title": "{{row.kpi_label}}",
              "value": "{{row.kpi_value}}",
              "unit": "{{row.kpi_unit}}",
              "max": "{{row.kpi_max}}",
              "target": "{{row.target}}",
              "limit": "{{row.limit}}",
              "trend": "{{row.trend}}",
              "delta": "{{row.delta}}",
              "delta_label": "{{row.since}}",
              "subtitle": "{{row.kpi_note}}",
              "from": {
                "set": "tiles"
              }
            }
          },
          {
            "kind": "chart",
            "bind": {
              "type": "line",
              "x": "m",
              "series": [
                {
                  "y": "rev",
                  "label": "Actual"
                },
                {
                  "y": "plan",
                  "label": "Plan"
                }
              ],
              "unit": "M",
              "label": "Revenue beat plan in November and December",
              "marker": {
                "field": "event"
              },
              "from": {
                "set": "mo"
              }
            }
          },
          {
            "kind": "chart",
            "bind": {
              "type": "area",
              "x": "m",
              "series": [
                {
                  "y": "cash",
                  "label": "Cash"
                }
              ],
              "unit": "M",
              "label": "Cash is up 22 percent, runway is not a worry",
              "limit": 20,
              "limit_label": "floor",
              "from": {
                "set": "mo"
              }
            }
          },
          {
            "kind": "chart",
            "bind": {
              "type": "line",
              "x": "m",
              "series": [
                {
                  "y": "cust",
                  "label": "Customers"
                }
              ],
              "unit": "",
              "label": "Customers up 42 percent in a year, November was the best month",
              "from": {
                "set": "mo"
              }
            }
          }
        ]
      }
    },
    "rows": [
      {
        "title": "Executive brief: December",
        "subtitle": "Sample data, one year of months",
