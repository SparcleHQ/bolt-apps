{
  "app": {
    "id": "gym",
    "chip": "gym",
    "title": "Gym and wellness",
    "icon": "activity",
    "description": "Wellness benefit: a ring hero, four tiles, claimed vs an even pace and a claims list. Needs Bolt 0.1.184 or newer. Sample data.",
    "service": "Gym and wellness"
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "SHOWCASE_API_KEY",
    "fixture_default": false,
    "on_missing_key": "sample",
    "fixture_file": "fixtures.json",
    "fixture_banner": false
  },
  "cache": {
    "ttl": 45,
    "stale_max": 86400
  },
  "endpoints": {
    "summary": {
      "path": "/v1/summary"
    }
  },
  "stats": {},
  "overview": {
    "widget": {
      "kind": "stack",
      "mode": "list_data",
      "bind": {
        "children": [
          {
            "kind": "gauge",
            "mode": "selected_row",
            "bind": {
              "value": "{{row.gused}}",
              "min": 0,
              "max": 100,
              "label": "Wellness benefit used",
              "unit": "%",
              "shape": "ring",
              "thresholds": [
                {
                  "at": 80,
                  "label": "watch 80%",
                  "tone": "warn"
                }
              ]
            }
          },
          {
            "kind": "cards",
            "bind": {
              "layout": "tiles",
              "visual_from": "kpi_visual",
              "title": "{{row.kpi_label}}",
              "value": "{{row.kpi_value}}",
              "unit": "{{row.kpi_unit}}",
              "max": "{{row.kpi_max}}",
              "target": "{{row.target}}",
              "limit": "{{row.limit}}",
              "trend": "{{row.trend}}",
              "delta": "{{row.delta}}",
              "delta_label": "{{row.since}}",
              "subtitle": "{{row.kpi_note}}",
              "from": {
                "set": "tiles"
              }
            }
          },
          {
            "kind": "chart",
            "bind": {
              "type": "area",
              "x": "m",
              "series": [
                {
                  "y": "spent",
                  "label": "Claimed"
                },
                {
                  "y": "pace",
                  "label": "Even pace"
                }
              ],
              "unit": "",
              "label": "Claims ran ahead of an even pace from May, USD",
              "limit": 600,
              "limit_label": "cap",
              "marker": {
                "field": "event"
              },
              "from": {
                "set": "mon"
              }
            }
          },
          {
            "kind": "table",
            "bind": {
              "columns": [
                {
                  "field": "claim",
                  "label": "Claim",
                  "total": "count"
                },
                {
                  "field": "amount",
                  "label": "USD",
                  "align": "right",
                  "format": "number",
                  "total": "none",
                  "bars": true
                },
                {
                  "field": "status",
                  "label": "Flag",
                  "mark": "tone"
                }
              ],
              "from": {
                "set": "claims"
              },
              "totals_label": "Claims"
            }
          }
        ]
      }
    },
    "rows": [
