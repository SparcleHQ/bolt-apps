{
  "app": {
    "id": "inventory",
    "chip": "inventory",
    "title": "Inventory",
    "icon": "list",
    "description": "A warehouse: bin fill heatmap by aisle and shelf, a low-stock table with bars and marks, and tiles. Needs Bolt 0.1.185 or newer. Sample data.",
    "service": "Inventory"
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "SHOWCASE_API_KEY",
    "fixture_default": false,
    "on_missing_key": "sample",
    "fixture_file": "fixtures.json",
    "fixture_banner": false
  },
  "cache": {
    "ttl": 45,
    "stale_max": 86400
  },
  "endpoints": {
    "summary": {
      "path": "/v1/summary"
    }
  },
  "stats": {},
  "overview": {
    "widget": {
      "kind": "tabs",
      "mode": "list_data",
      "bind": {
        "tabs": [
          {
            "label": "Floor",
            "widget": {
              "kind": "stack",
              "mode": "list_data",
              "bind": {
                "children": [
                  {
                    "kind": "cards",
                    "bind": {
                      "layout": "tiles",
                      "visual_from": "kpi_visual",
                      "title": "{{row.kpi_label}}",
                      "value": "{{row.kpi_value}}",
                      "unit": "{{row.kpi_unit}}",
                      "max": "{{row.kpi_max}}",
                      "target": "{{row.target}}",
                      "limit": "{{row.limit}}",
                      "trend": "{{row.trend}}",
                      "delta": "{{row.delta}}",
                      "delta_label": "{{row.since}}",
                      "subtitle": "{{row.kpi_note}}",
                      "from": {
                        "set": "tiles"
                      }
                    }
                  },
                  {
                    "kind": "heatmap",
                    "bind": {
                      "x": "shelf",
                      "y": "aisle",
                      "value": "fill",
                      "label": "Bin fill by aisle and shelf, %",
                      "from": {
                        "set": "heat"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "label": "Reorder",
            "widget": {
              "kind": "stack",
              "mode": "list_data",
              "bind": {
                "children": [
                  {
                    "kind": "table",
                    "bind": {
                      "columns": [
                        {
                          "field": "nm",
                          "label": "Item"
                        },
                        {
                          "field": "on_hand",
                          "label": "On hand",
                          "align": "right",
                          "format": "number",
                          "bars": true,
                          "total": "sum"
                        },
                        {
                          "field": "cover",
                          "label": "Cover",
                          "align": "right",
                          "format": "number",
                          "digits": 1,
                          "unit": "d",
                          "total": "none"
                        },
                        {
                          "field": "status",
                          "label": "Flag",
                          "mark": "tone"
                        }
                      ],
                      "from": {
                        "set": "low"
                      },
                      "totals_label": "Low stock"
                    }
                  }
                ]
              }
            },
            "count_from": {
              "set": "low"
            },
            "status": "warning"
          },
          {
            "label": "Movement",
            "widget": {
              "kind": "stack",
              "mode": "list_data",
              "bind": {
                "children": [
                  {
                    "kind": "chart",
                    "bind": {
                      "type": "line",
                      "x": "w",
                      "series": [
                        {
                          "y": "inb",
                          "label": "Received"
                        },
                        {
                          "y": "out",
                          "label": "Shipped"
                        }
                      ],
                      "unit": "",
                      "label": "Units received and shipped per week",
                      "limit": 1500,
                      "limit_label": "dock capacity",
                      "marker": {
                        "field": "event"
                      },
                      "from": {
                        "set": "move"
                      }
                    }
                  },
                  {
                    "kind": "table",
                    "bind": {
                      "columns": [
                        {
                          "field": "cat",
                          "label": "Category"
                        },
                        {
                          "field": "skus",
                          "label": "SKUs",
                          "align": "right",
                          "format": "number",
                          "total": "sum"
                        },
                        {
                          "field": "value",
                          "label": "Value",
                          "align": "right",
                          "format": "compact",
                          "bars": true,
                          "total": "sum",
                          "digits": 1
                        },
                        {
                          "field": "status",
                          "label": "Cover",
                          "mark": "tone"
                        }
                      ],
                      "from": {
                        "set": "cat"
                      },
                      "totals_label": "Categories"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
