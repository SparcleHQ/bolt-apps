          "h_src": "jobs",
          "h_label": "D1",
          "h_value": 0
        }
      },
      {
        "title": "jobs history 2",
        "subtitle": "a row of the set hist",
        "icon": "line-chart",
        "extra": {
          "set": "hist",
          "h_src": "jobs",
          "h_label": "D2",
          "h_value": 0
        }
      },
      {
        "title": "jobs history 3",
        "subtitle": "a row of the set hist",
        "icon": "line-chart",
        "extra": {
          "set": "hist",
