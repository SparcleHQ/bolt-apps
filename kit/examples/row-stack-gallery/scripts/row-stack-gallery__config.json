          "h_label": "D3",
          "h_value": 1
        }
      },
      {
        "title": "jobs history 4",
        "subtitle": "a row of the set hist",
        "icon": "line-chart",
        "extra": {
          "set": "hist",
          "h_src": "jobs",
          "h_label": "D4",
          "h_value": 0
        }
      },
      {
        "title": "Deploys this week",
        "subtitle": "an ordinary list_data view",
        "icon": "line-chart",
        "view": "weekly"
      }
    ]
  },
  "views": [
    {
      "id": "weekly",
      "title": "Deploys (rows)",
      "icon": "line-chart",
      "endpoint": "weekly",
      "item": {
        "title": "{day} \u00b7 {count}",
        "subtitle": "deploys per day",
        "extra": {
          "label": "{day}",
          "value": "{count}"
        }
      },
      "widget": {
        "kind": "chart",
        "mode": "list_data",
        "bind": {
          "type": "line",
          "x": "label",
          "y": "value",
          "label": "Deploys by day"
        }
      }
    }
  ]
}