{
  "app": {
    "id": "sales-pipeline",
    "chip": "sales-pipeline",
    "title": "Sales pipeline",
    "icon": "trending-up",
    "description": "Sales pipeline: a wide area chart first, tiles, a stage funnel table with bars and a top deals list. Needs Bolt 0.1.184 or newer. Sample data.",
    "service": "Sales pipeline"
  },
  "api": {
    "base_url": "https://api.example.com",
    "key_env": "SHOWCASE_API_KEY",
    "fixture_default": false,
    "on_missing_key": "sample",
    "fixture_file": "fixtures.json",
    "fixture_banner": false
  },
  "cache": {
    "ttl": 45,
    "stale_max": 86400
  },
  "endpoints": {
    "summary": {
      "path": "/v1/summary"
    }
  },
  "stats": {},
  "overview": {
    "widget": {
      "kind": "stack",
      "mode": "list_data",
      "bind": {
        "children": [
          {
            "kind": "chart",
            "bind": {
              "type": "area",
              "x": "w",
              "series": [
                {
                  "y": "open",
                  "label": "Open"
                },
                {
                  "y": "commit",
                  "label": "Commit"
                }
              ],
              "unit": "M",
              "label": "Open pipeline grew 41% in 12 weeks, commit kept pace (M USD)",
              "limit": 5.2,
              "limit_label": "quota x3",
              "marker": {
                "field": "event"
              },
              "from": {
                "set": "wk"
              }
            }
          },
          {
            "kind": "cards",
            "bind": {
              "layout": "tiles",
              "visual_from": "kpi_visual",
              "title": "{{row.kpi_label}}",
              "value": "{{row.kpi_value}}",
              "unit": "{{row.kpi_unit}}",
              "max": "{{row.kpi_max}}",
              "target": "{{row.target}}",
              "limit": "{{row.limit}}",
              "trend": "{{row.trend}}",
              "delta": "{{row.delta}}",
              "delta_label": "{{row.since}}",
              "subtitle": "{{row.kpi_note}}",
              "from": {
                "set": "tiles"
              }
            }
          },
          {
            "kind": "table",
            "bind": {
              "columns": [
                {
                  "field": "stage",
                  "label": "Stage",
                  "total": "count"
                },
                {
                  "field": "deals",
                  "label": "Deals",
                  "align": "right",
                  "format": "number",
                  "bars": true,
                  "total": "none"
                },
                {
                  "field": "value",
                  "label": "M USD",
                  "align": "right",
                  "format": "number",
                  "digits": 1,
                  "total": "none"
                },
                {
                  "field": "flag",
                  "label": "Flag",
                  "mark": "tone"
                }
              ],
              "from": {
                "set": "stages"
              },
              "totals_label": "Funnel"
            }
          },
          {
            "kind": "table",
            "bind": {
              "columns": [
                {
                  "field": "deal",
                  "label": "Top deals"
                },
                {
                  "field": "amount",
                  "label": "k USD",
                  "align": "right",
                  "format": "number",
                  "bars": true,
                  "total": "sum"
                },
                {
                  "field": "idle",
                  "label": "Idle d",
                  "align": "right",
                  "format": "number",
                  "total": "none"
                },
                {
                  "field": "flag",
                  "label": "Flag",
                  "mark": "tone"
                }
              ],
              "from": {
                "set": "deals"
              },
              "totals_label": "Top 10"
            }
          }
        ]
      }
    },
    "rows": [
