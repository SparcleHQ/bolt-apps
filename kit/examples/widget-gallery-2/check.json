      "os": "macos",
      "fixture": "unset",
      "args": [
        "overview"
      ],
      "expect": {
        "text_present": [
          "sample data"
        ]
      }
    },
    {
      "name": "sample label is visible in the card view (no key)",
      "os": "macos",
