{
 "app": {
  "id": "widget-gallery-2",
  "chip": "widget-gallery-2",
  "title": "Widget gallery 2",
  "icon": "Image",
  "description": "The card pane, the image grid, the cards grid with images and the service map graph. Sample data: generated colour swatches as inline images and six invented services.",
  "service": "Widget gallery",
  "searchable": false
 },
 "api": {
  "base_url": "https://api.example.com",
  "key_env": "GALLERY2_API_KEY",
  "env_file": "~/.config/widget-gallery-2/.env",
  "fixture_default": false,
  "on_missing_key": "sample",
  "fixture_file": "fixtures.json",
  "fixture_banner": false
 },
 "cache": {
  "ttl": 45,
  "stale_max": 86400
 },
 "endpoints": {
  "swatches": {
   "path": "/v1/swatches",
   "map": {
    "title": "name"
   }
  },
  "calls": {
   "path": "/v1/calls",
   "map": {
    "title": "name"
   }
  }
 },
 "stats": {
  "swatches_total": {
   "endpoint": "swatches"
  },
  "services_total": {
   "endpoint": "calls"
  }
 },
 "overview": {
  "widget": {
   "kind": "cards",
   "mode": "list_data",
   "bind": {
    "layout": "tiles",
    "title": "{{row.kpi_label}}",
    "value": "{{row.kpi_value}}",
    "unit": "{{row.kpi_unit}}",
    "delta": "{{row.delta}}",
    "delta_label": "{{row.since}}",
    "max": "{{row.kpi_max}}",
    "trend": "{{row.trend}}",
    "subtitle": "{{row.kpi_note}}",
    "badge": "{{row.kpi_badge}}",
    "footer": "{{row.kpi_foot}}"
   }
  },
  "rows": [
   {
    "title": "Card",
    "subtitle": "One title, one line, copy action",
    "icon": "file",
    "view": "card",
    "tile": {
     "label": "Swatches",
     "value": "swatches_total",
     "note": "colours"
    }
   },
   {
    "title": "Image grid",
    "subtitle": "Thumbnails from inline images",
    "icon": "Image",
    "view": "grid",
    "tile": {
     "label": "Thumbnails",
     "value": "swatches_total",
     "note": "inline PNG, no network"
    }
   },
   {
    "title": "Cards with images",
    "subtitle": "Grid layout, image on each card",
    "icon": "Image",
    "view": "cardsimg",
    "tile": {
     "label": "Cards",
     "value": "swatches_total",
     "note": "grid layout"
    }
   },
   {
    "title": "Service map",
    "subtitle": "Nodes and links, laid out by Bolt (Bolt 0.1.184)",
    "icon": "activity",
    "view": "graph",
    "tile": {
     "label": "Services",
     "value": "services_total",
     "note": "in the map"
    }
   }
  ]
 },
 "views": [
  {
   "id": "card",
   "title": "Card",
   "icon": "file",
   "endpoint": "swatches",
   "item": {
    "title": "{title} {hex}",
    "subtitle": "{note}",
    "extra": {
     "name": "{title}",
     "note": "{note}",
     "hex": "{hex}",
     "src": "{src}"
    }
   },
   "widget": {
    "kind": "card",
    "mode": "selected_row",
    "bind": {
     "title": "{{row.name}}",
     "subtitle": "{{row.note}}",
     "actions": [
      "copy"
     ]
    }
   }
  },
  {
   "id": "grid",
   "title": "Image grid",
   "icon": "Image",
   "endpoint": "swatches",
   "item": {
    "title": "{title}",
    "subtitle": "{hex}",
    "extra": {
     "name": "{title}",
     "note": "{note}",
     "hex": "{hex}",
     "src": "{src}"
    }
   },
   "widget": {
    "kind": "image_grid",
    "mode": "list_data",
    "bind": {
     "src": "{{row.src}}",
     "caption": "{{row.name}}",
     "alt": "{{row.name}} swatch",
     "columns": 3
    }
   }
  },
  {
   "id": "cardsimg",
   "title": "Cards with images",
   "icon": "Image",
   "endpoint": "swatches",
   "item": {
    "title": "{title}",
    "subtitle": "{hex}",
    "extra": {
     "name": "{title}",
     "note": "{note}",
     "hex": "{hex}",
     "src": "{src}",
     "uses": "{uses}"
    }
   },
   "widget": {
    "kind": "cards",
    "mode": "list_data",
    "bind": {
     "layout": "grid",
     "title": "{{row.name}}",
     "subtitle": "{{row.hex}}",
     "image": "{{row.src}}",
     "footer": "{{row.uses}} uses"
    }
   }
  },
  {
   "id": "graph",
   "title": "Service map",
   "icon": "activity",
   "endpoint": "calls",
   "item": {
    "title": "{name}",
    "subtitle": "{state}",
    "extra": {
     "id": "{id}",
     "name": "{name}",
     "state": "{state}",
     "calls": "{calls}",
     "team": "{team}"
    }
   },
   "widget": {
    "kind": "graph",
    "mode": "list_data",
    "bind": {
     "id": "id",
     "label": "name",
     "status": "state",
     "to": "calls",
     "group": "team",
     "title": "Service map"
    }
   }
  }
 ]
}
