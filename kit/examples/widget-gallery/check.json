    {
      "name": "sample label is visible in the preview view (no key)",
      "os": "macos",
      "fixture": "unset",
      "args": [
        "preview"
      ],
      "expect": {}
    },
    {
      "name": "sample label is visible in the markdown view (no key)",
      "os": "macos",
