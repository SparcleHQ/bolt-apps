{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparcle.app/schemas/user-app-v1.json",
  "title": "Bolt User App (utilities/<id>.yaml) v1",
  "description": "Structure of a User App, matching what the Bolt desktop app accepts as of 2026-10-20. Unknown fields are refused, and so are the admin connector fields. The desktop app also checks rules a JSON Schema cannot express: no shell operators in a command, variables never inside quotes, recognize regexes must compile, per-runtime blocks. The gallery accepts runtime: transform only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "id", "chip", "title", "emits", "presentation"],
  "properties": {
    "schema_version": { "const": 1 },
    "runtime": { "enum": ["transform", "http_local", "bridge"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "chip": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "The key typed after =." },
    "title": { "type": "string", "minLength": 1 },
    "icon": { "type": "string" },
    "description": { "type": "string" },
    "placeholder_examples": { "type": "array", "items": { "type": "string" } },
    "emits": { "enum": ["Person", "Issue", "Document", "Event", "File", "Incident", "Account", "Place", "Generic"] },
    "args": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "from"],
        "properties": {
          "name": { "type": "string" },
          "from": { "type": "string", "pattern": "^query\\.word\\(\\d+\\)$" },
          "default": {}
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget"],
      "properties": {
        "widget": { "enum": ["list", "table", "cards", "detail"] },
        "title_field": { "type": "string" },
        "subtitle_field": { "type": "string" },
        "searchable": { "type": "boolean" },
        "right_widget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["card", "map", "image", "calc", "color", "weather", "date", "markdown", "entity_preview", "chart", "table", "cards", "detail", "json_tree", "diff", "image_grid"] },
            "mode": { "enum": ["selected_row", "list_data"] },
            "bind": {}
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["url", "composer", "utility"] }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "confirm" },
        "confirm_label": { "type": "string" },
        "confirm_hint": { "type": "string" },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "hint": { "type": "string" },
              "args": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "detect": {
      "type": "object",
      "required": ["binary"],
      "properties": {
        "binary": { "type": "string", "pattern": "^[^/\\\\]+$", "description": "A program name on PATH, never a path." },
        "version_min": { "type": "string" },
        "auth_check": {},
        "config_hint": { "type": "array", "items": { "type": "string" } },
        "refresh": { "enum": ["on_boot", "on_focus", "manual"] },
        "setup": {}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "label"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["text", "number", "date", "select", "toggle", "secret"] },
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {},
          "placeholder": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "max_length": { "type": "integer" },
          "pattern": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "submit": { "type": "object" },
    "recognize": {
      "type": "object",
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["regex"],
            "properties": {
              "regex": { "type": "string", "maxLength": 512 },
              "flags": { "type": "string" },
              "priority": { "type": "integer" }
            }
          }
        },
        "entity": { "type": "string" },
        "confidence": { "enum": ["ambient", "high"] },
        "anchors": { "type": "object" },
        "reps": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["label", "template"],
            "properties": { "label": { "type": "string" }, "template": { "type": "string" } }
          }
        }
      }
    },
    "transform": {
      "type": "object",
      "required": ["pipe"],
      "properties": {
        "pipe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              { "enum": ["lines", "sort", "dedupe", "reverse", "trim", "upper", "lower", "title", "camel", "snake", "kebab", "slug", "table", "markdown", "csv", "aligned", "sql", "json", "yaml", "toml", "env", "properties", "transpose", "flatten", "redact_secrets", "sanitize"] },
              {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "propertyNames": { "enum": ["split", "join", "filter", "head", "tail", "slice", "replace", "prefix", "suffix", "template", "sortcol", "dedupecol", "rename_cols", "pick", "omit"] }
              }
            ]
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "request", "parse"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "host": { "enum": ["127.0.0.1", "::1", "localhost"] },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "method": { "enum": ["GET", "POST"] }, "path": { "type": "string" } }
        },
        "parse": { "enum": ["json", "lines", "raw"] },
        "rows_path": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "headers": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9-]+$" }, "additionalProperties": { "type": "string", "anyOf": [ { "not": { "pattern": "\\$\\{" } }, { "pattern": "^\\$\\{env:(GH_HOST|GH_REPO|GITLAB_HOST|DOCKER_CONTEXT|DOCKER_TLS_VERIFY|AWS_PROFILE|AWS_REGION|AWS_DEFAULT_REGION|AWS_CA_BUNDLE|AWS_ENDPOINT_URL|CLOUDSDK_CORE_PROJECT|OKTA_CLIENT_ORGURL|SF_TARGET_ORG|SF_ORG_INSTANCE_URL|TWILIO_ACCOUNT_SID|TWILIO_REGION|TWILIO_EDGE|VERCEL_ORG_ID|VERCEL_PROJECT_ID|PGHOST|PGPORT|PGUSER|PGDATABASE|PGSERVICE|PGSSLMODE)\\}$" } ] } }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "parse"],
      "properties": {
        "command": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": { "macos": { "type": "string" }, "linux": { "type": "string" }, "windows": { "type": "string" } }
        },
        "parse": { "enum": ["json", "lines", "raw"] },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
        "env": {
          "description": "Each key is a variable the app may read (the env_passthrough list) and its value is exactly that variable: \"NAME\": \"${env:NAME}\". A gallery app cannot forward a variable under another name. Mirrors env_destination_refusal in bolt-native contract.rs.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$", "not": { "anyOf": [ { "enum": ["PATH", "HOME", "USER", "LOGNAME", "TMPDIR", "SHELL", "IFS", "NODE_OPTIONS", "NODE_PATH", "PYTHONPATH", "PYTHONSTARTUP", "PYTHONHOME", "PYTHONINSPECT", "PYTHONUSERBASE", "PERL5OPT", "PERL5LIB", "RUBYOPT", "RUBYLIB", "BASH_ENV", "ENV", "GIT_SSH_COMMAND", "GIT_EXTERNAL_DIFF", "GIT_PAGER", "GIT_ASKPASS", "EDITOR", "VISUAL", "PAGER", "JAVA_TOOL_OPTIONS", "_JAVA_OPTIONS", "CLASSPATH", "GCONV_PATH", "SSLKEYLOGFILE", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY", "COMSPEC", "PATHEXT", "OPENSSL_CONF", "OPENSSL_MODULES"] }, { "pattern": "^(LD_|DYLD_|BOLT_|ANTHROPIC_|OPENAI_|GIT_CONFIG|GIT_TRACE)" } ] } },
          "properties": { "GH_HOST": { "const": "${env:GH_HOST}" }, "GH_REPO": { "const": "${env:GH_REPO}" }, "GITLAB_HOST": { "const": "${env:GITLAB_HOST}" }, "DOCKER_CONTEXT": { "const": "${env:DOCKER_CONTEXT}" }, "DOCKER_TLS_VERIFY": { "const": "${env:DOCKER_TLS_VERIFY}" }, "AWS_PROFILE": { "const": "${env:AWS_PROFILE}" }, "AWS_REGION": { "const": "${env:AWS_REGION}" }, "AWS_DEFAULT_REGION": { "const": "${env:AWS_DEFAULT_REGION}" }, "AWS_CA_BUNDLE": { "const": "${env:AWS_CA_BUNDLE}" }, "AWS_ENDPOINT_URL": { "const": "${env:AWS_ENDPOINT_URL}" }, "CLOUDSDK_CORE_PROJECT": { "const": "${env:CLOUDSDK_CORE_PROJECT}" }, "OKTA_CLIENT_ORGURL": { "const": "${env:OKTA_CLIENT_ORGURL}" }, "SF_TARGET_ORG": { "const": "${env:SF_TARGET_ORG}" }, "SF_ORG_INSTANCE_URL": { "const": "${env:SF_ORG_INSTANCE_URL}" }, "TWILIO_ACCOUNT_SID": { "const": "${env:TWILIO_ACCOUNT_SID}" }, "TWILIO_REGION": { "const": "${env:TWILIO_REGION}" }, "TWILIO_EDGE": { "const": "${env:TWILIO_EDGE}" }, "VERCEL_ORG_ID": { "const": "${env:VERCEL_ORG_ID}" }, "VERCEL_PROJECT_ID": { "const": "${env:VERCEL_PROJECT_ID}" }, "PGHOST": { "const": "${env:PGHOST}" }, "PGPORT": { "const": "${env:PGPORT}" }, "PGUSER": { "const": "${env:PGUSER}" }, "PGDATABASE": { "const": "${env:PGDATABASE}" }, "PGSERVICE": { "const": "${env:PGSERVICE}" }, "PGSSLMODE": { "const": "${env:PGSSLMODE}" } },
          "additionalProperties": false
        },
        "env_passthrough": {
          "description": "Environment variables the command reads. Commands start with an empty environment plus a fixed set Bolt chooses; an app may add only these names (hosts, regions, profiles, config paths, public identifiers). Credentials, loader and interpreter settings, proxies and Bolt settings are never forwarded to a gallery app. Mirrors BENIGN_PASSTHROUGH_NAMES in bolt-native contract.rs and bolt-pwa check.ts; keep all three in step.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "enum": ["GH_HOST", "GH_REPO", "GITLAB_HOST", "DOCKER_CONTEXT", "DOCKER_TLS_VERIFY", "AWS_PROFILE", "AWS_REGION", "AWS_DEFAULT_REGION", "AWS_CA_BUNDLE", "AWS_ENDPOINT_URL", "CLOUDSDK_CORE_PROJECT", "OKTA_CLIENT_ORGURL", "SF_TARGET_ORG", "SF_ORG_INSTANCE_URL", "TWILIO_ACCOUNT_SID", "TWILIO_REGION", "TWILIO_EDGE", "VERCEL_ORG_ID", "VERCEL_PROJECT_ID", "PGHOST", "PGPORT", "PGUSER", "PGDATABASE", "PGSERVICE", "PGSSLMODE"] }
        },
        "cwd": {
          "description": "Working directory. Absent: a fresh private folder per run. home: the user's home folder (needs the files permission).",
          "enum": ["home"]
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "runtime": { "const": "transform" } } }, "then": { "required": ["transform"], "not": { "anyOf": [{ "required": ["bridge"] }, { "required": ["http"] }] } } },
    { "if": { "properties": { "runtime": { "const": "http_local" } } }, "then": { "required": ["http"], "not": { "required": ["bridge"] } } },
    { "if": { "properties": { "runtime": { "const": "bridge" } } }, "then": { "required": ["bridge"], "not": { "required": ["http"] } } }
  ]
}
